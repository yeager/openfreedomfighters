+static void VULKAN_INTERNAL_FreeExtensionList(SDL_GPUVulkanExtensionList *extensions)
+{
+    if (extensions) {
+        for (Uint32 i = 0; i < extensions->count; ++i) {
+            SDL_free(extensions->names[i]);
+        }
+        SDL_free(extensions->names);
+        SDL_zero(*extensions);
+    }
+}
+
+static bool VULKAN_INTERNAL_CopyExtensionList(SDL_GPUVulkanExtensionList *dst, const SDL_GPUVulkanExtensionList *src)
+{
+    VULKAN_INTERNAL_FreeExtensionList(dst);
+    for (Uint32 i = 0; i < src->count; ++i) {
+        if (!SDL_AddGPUVulkanExtension(dst, src->names[i])) {
+            VULKAN_INTERNAL_FreeExtensionList(dst);
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool VULKAN_INTERNAL_AppendUniqueExtension(const char *name, const char **names, Uint32 *count)
+{
+    for (Uint32 i = 0; i < *count; ++i) {
+        if (SDL_strcmp(name, names[i]) == 0) {
+            return true;
+        }
+    }
+    names[(*count)++] = name;
+    return true;
+}

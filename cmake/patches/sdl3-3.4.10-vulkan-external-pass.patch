+bool SDL_AddGPUVulkanExtension(SDL_GPUVulkanExtensionList *extensions, const char *extension_name)
+{
+    CHECK_PARAM(extensions == NULL) {
+        return SDL_InvalidParamError("extensions");
+    }
+    CHECK_PARAM(extension_name == NULL || extension_name[0] == '\0') {
+        return SDL_InvalidParamError("extension_name");
+    }
+    for (Uint32 i = 0; i < extensions->count; ++i) {
+        if (SDL_strcmp(extensions->names[i], extension_name) == 0) {
+            return true;
+        }
+    }
+    if (extensions->count == extensions->capacity) {
+        Uint32 newCapacity = extensions->capacity ? extensions->capacity * 2 : 8;
+        if (newCapacity < extensions->capacity || newCapacity > SDL_SIZE_MAX / sizeof(char *)) {
+            return SDL_SetError("Vulkan extension list is too large");
+        }
+        char **newNames = (char **)SDL_realloc(extensions->names, newCapacity * sizeof(char *));
+        if (newNames == NULL) {
+            return SDL_OutOfMemory();
+        }
+        extensions->names = newNames;
+        extensions->capacity = newCapacity;
+    }
+    extensions->names[extensions->count] = SDL_strdup(extension_name);
+    if (extensions->names[extensions->count] == NULL) {
+        return SDL_OutOfMemory();
+    }
+    extensions->count += 1;
+    return true;
+}
+
+bool SDL_RunGPUVulkanExternalPass(
+    SDL_GPUCommandBuffer *command_buffer,
+    const SDL_GPUVulkanExternalTextureUse *texture_uses,
+    Uint32 texture_use_count,
+    SDL_GPUVulkanExternalPassCallback callback,
+    void *userdata)
+{
+    CHECK_PARAM(command_buffer == NULL) {
+        return SDL_InvalidParamError("command_buffer");
+    }
+    CHECK_PARAM(texture_uses == NULL || texture_use_count == 0) {
+        return SDL_InvalidParamError("texture_uses");
+    }
+    CHECK_PARAM(callback == NULL) {
+        return SDL_InvalidParamError("callback");
+    }
+    CHECK_COMMAND_BUFFER_RETURN_FALSE;
+    CHECK_ANY_PASS_IN_PROGRESS("Cannot run a Vulkan external pass inside an SDL GPU pass!", false);
+
+    SDL_GPUDevice *device = ((CommandBufferCommonHeader *)command_buffer)->device;
+    CHECK_DEVICE_MAGIC(device, false);
+    if (device->RunGPUVulkanExternalPass == NULL) {
+        return SDL_SetError("Vulkan external passes require SDL's Vulkan GPU backend");
+    }
+    return device->RunGPUVulkanExternalPass(
+        command_buffer, texture_uses, texture_use_count, callback, userdata);
+}

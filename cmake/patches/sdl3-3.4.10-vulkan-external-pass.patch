+
+static bool VULKAN_RunGPUVulkanExternalPass(
+    SDL_GPUCommandBuffer *command_buffer,
+    const SDL_GPUVulkanExternalTextureUse *texture_uses,
+    Uint32 texture_use_count,
+    SDL_GPUVulkanExternalPassCallback callback,
+    void *userdata)
+{
+    VulkanCommandBuffer *vulkan_command_buffer = (VulkanCommandBuffer *)command_buffer;
+    VulkanRenderer *renderer = vulkan_command_buffer->renderer;
+    VulkanTexture **textures = NULL;
+    VulkanTextureUsageMode *access_modes = NULL;
+    SDL_GPUVulkanExternalTexture *external_textures = NULL;
+    SDL_GPUVulkanExternalPassContext context;
+    bool callback_result;
+    Uint32 i, j;
+    VkQueueFlags graphics_queue_family_flags = 0;
+
+    if (vulkan_command_buffer->common.submitted ||
+        vulkan_command_buffer->common.swapchain_texture_acquired ||
+        vulkan_command_buffer->common.render_pass.in_progress ||
+        vulkan_command_buffer->common.compute_pass.in_progress ||
+        vulkan_command_buffer->common.copy_pass.in_progress) {
+        return SDL_SetError("Vulkan external pass requires an acquired command buffer outside an SDL GPU pass");
+    }
+
+    if (texture_use_count > SDL_SIZE_MAX / sizeof(*textures) ||
+        texture_use_count > SDL_SIZE_MAX / sizeof(*access_modes) ||
+        texture_use_count > SDL_SIZE_MAX / sizeof(*external_textures)) {
+        return SDL_SetError("Vulkan external pass texture list is too large");
+    }
+
+    textures = (VulkanTexture **)SDL_calloc(texture_use_count, sizeof(*textures));
+    access_modes = (VulkanTextureUsageMode *)SDL_calloc(texture_use_count, sizeof(*access_modes));
+    external_textures = (SDL_GPUVulkanExternalTexture *)SDL_calloc(texture_use_count, sizeof(*external_textures));
+    if (textures == NULL || access_modes == NULL || external_textures == NULL) {
+        SDL_free(textures);
+        SDL_free(access_modes);
+        SDL_free(external_textures);
+        return SDL_OutOfMemory();
+    }
+
+    /* Validate the whole set before recording any barriers. */
+    Uint32 queue_family_count = 0;
+    renderer->vkGetPhysicalDeviceQueueFamilyProperties(
+        renderer->physicalDevice, &queue_family_count, NULL);
+    if (renderer->queueFamilyIndex >= queue_family_count) {
+        SDL_SetError("Selected Vulkan queue family is unavailable");
+        goto fail;
+    }
+    VkQueueFamilyProperties *queue_family_properties = SDL_stack_alloc(
+        VkQueueFamilyProperties, queue_family_count);
+    if (queue_family_properties == NULL) {
+        SDL_OutOfMemory();
+        goto fail;
+    }
+    renderer->vkGetPhysicalDeviceQueueFamilyProperties(
+        renderer->physicalDevice, &queue_family_count, queue_family_properties);
+    graphics_queue_family_flags =
+        queue_family_properties[renderer->queueFamilyIndex].queueFlags;
+    SDL_stack_free(queue_family_properties);
+
+    for (i = 0; i < texture_use_count; i += 1) {
+        VulkanTextureContainer *container;
+        Uint32 format;
+
+        if (texture_uses[i].texture == NULL) {
+            SDL_SetError("Vulkan external pass contains a null texture");
+            goto fail;
+        }
+        if (((TextureCommonHeader *)texture_uses[i].texture)->device != vulkan_command_buffer->common.device) {
+            SDL_SetError("Vulkan external pass texture is not owned by this device; swapchain textures are unsupported");
+            goto fail;
+        }
+        container = (VulkanTextureContainer *)texture_uses[i].texture;
+        textures[i] = container->activeTexture;
+        if (textures[i] == NULL ||
+            textures[i]->type != SDL_GPU_TEXTURETYPE_2D ||
+            textures[i]->levelCount != 1 ||
+            textures[i]->layerCount != 1) {
+            SDL_SetError("Vulkan external pass requires live single-level 2D textures");
+            goto fail;
+        }
+
+        switch (texture_uses[i].access) {
+        case SDL_GPU_VULKAN_EXTERNAL_TEXTURE_SAMPLED:
+            if ((textures[i]->usage & SDL_GPU_TEXTUREUSAGE_SAMPLER) == 0) {
+                SDL_SetError("Sampled external texture lacks SDL_GPU_TEXTUREUSAGE_SAMPLER");
+                goto fail;
+            }
+            access_modes[i] = VULKAN_TEXTURE_USAGE_MODE_SAMPLER;
+            break;
+        case SDL_GPU_VULKAN_EXTERNAL_TEXTURE_STORAGE_READ:
+            if ((textures[i]->usage & SDL_GPU_TEXTUREUSAGE_COMPUTE_STORAGE_READ) == 0) {
+                SDL_SetError("Read-only external texture lacks SDL_GPU_TEXTUREUSAGE_COMPUTE_STORAGE_READ");
+                goto fail;
+            }
+            access_modes[i] = VULKAN_TEXTURE_USAGE_MODE_COMPUTE_STORAGE_READ;
+            break;
+        case SDL_GPU_VULKAN_EXTERNAL_TEXTURE_STORAGE_WRITE:
+            if ((textures[i]->usage & (SDL_GPU_TEXTUREUSAGE_COMPUTE_STORAGE_WRITE | SDL_GPU_TEXTUREUSAGE_COMPUTE_STORAGE_SIMULTANEOUS_READ_WRITE)) == 0) {
+                SDL_SetError("Write-only external texture lacks SDL_GPU_TEXTUREUSAGE_COMPUTE_STORAGE_WRITE");
+                goto fail;
+            }
+            access_modes[i] = VULKAN_TEXTURE_USAGE_MODE_COMPUTE_STORAGE_READ_WRITE;
+            break;
+        case SDL_GPU_VULKAN_EXTERNAL_TEXTURE_STORAGE_READ_WRITE:
+            if ((textures[i]->usage & SDL_GPU_TEXTUREUSAGE_COMPUTE_STORAGE_SIMULTANEOUS_READ_WRITE) == 0) {
+                SDL_SetError("Read-write external texture lacks SDL_GPU_TEXTUREUSAGE_COMPUTE_STORAGE_SIMULTANEOUS_READ_WRITE");
+                goto fail;
+            }
+            access_modes[i] = VULKAN_TEXTURE_USAGE_MODE_COMPUTE_STORAGE_READ_WRITE;
+            break;
+        default:
+            SDL_SetError("Vulkan external pass contains an invalid texture access mode");
+            goto fail;
+        }
+
+        for (j = 0; j < i; j += 1) {
+            if (textures[j] == textures[i]) {
+                SDL_SetError("Vulkan external pass texture list contains duplicates");
+                goto fail;
+            }
+        }
+
+        format = (Uint32)container->header.info.format;
+        if (format >= SDL_arraysize(SDLToVK_TextureFormat)) {
+            SDL_SetError("Vulkan external pass texture format is invalid");
+            goto fail;
+        }
+
+        VkImageView externalView = access_modes[i] == VULKAN_TEXTURE_USAGE_MODE_COMPUTE_STORAGE_READ_WRITE
+                                       ? textures[i]->subresources[0].computeWriteView
+                                       : textures[i]->fullView;
+        if (externalView == VK_NULL_HANDLE) {
+            SDL_SetError("Vulkan external pass texture has no view compatible with requested access");
+            goto fail;
+        }
+        external_textures[i].image = (Uint64)(uintptr_t)textures[i]->image;
+        external_textures[i].image_view = (Uint64)(uintptr_t)externalView;
+        external_textures[i].format = (Uint32)SDLToVK_TextureFormat[format];
+        external_textures[i].aspect_mask = access_modes[i] == VULKAN_TEXTURE_USAGE_MODE_COMPUTE_STORAGE_READ_WRITE
+                                               ? (Uint32)textures[i]->aspectFlags
+                                               : (Uint32)(textures[i]->aspectFlags & ~VK_IMAGE_ASPECT_STENCIL_BIT);
+        external_textures[i].width = container->header.info.width;
+        external_textures[i].height = container->header.info.height;
+        external_textures[i].depth = 1;
+        external_textures[i].image_type = VK_IMAGE_TYPE_2D;
+        external_textures[i].image_create_flags = (Uint32)textures[i]->imageCreateFlags;
+        external_textures[i].image_usage = (Uint32)textures[i]->imageUsage;
+        external_textures[i].image_tiling = VK_IMAGE_TILING_OPTIMAL;
+        external_textures[i].sample_count = (Uint32)SDLToVK_SampleCount[container->header.info.sample_count];
+        external_textures[i].mip_levels = textures[i]->levelCount;
+        external_textures[i].array_layers = textures[i]->layerCount;
+        external_textures[i].view_type = VK_IMAGE_VIEW_TYPE_2D;
+        external_textures[i].view_base_mip_level = 0;
+        external_textures[i].view_level_count = 1;
+        external_textures[i].view_base_array_layer = 0;
+        external_textures[i].view_layer_count = 1;
+        external_textures[i].component_swizzle_r = (Uint32)textures[i]->swizzle.r;
+        external_textures[i].component_swizzle_g = (Uint32)textures[i]->swizzle.g;

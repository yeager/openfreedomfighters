if(NOT DEFINED SDL3_SOURCE_DIR OR NOT IS_DIRECTORY "${SDL3_SOURCE_DIR}")
    message(FATAL_ERROR "SDL3_SOURCE_DIR is required to apply the SDL Vulkan interop patch")
endif()
if(NOT DEFINED PATCH_EXECUTABLE OR NOT EXISTS "${PATCH_EXECUTABLE}")
    message(FATAL_ERROR "PATCH_EXECUTABLE is required to apply the SDL Vulkan interop patch")
endif()
if(NOT DEFINED PATCH_FILE OR NOT EXISTS "${PATCH_FILE}")
    message(FATAL_ERROR "PATCH_FILE is required to apply the SDL Vulkan interop patch")
endif()

set(SDL_GPU_HEADER "${SDL3_SOURCE_DIR}/include/SDL3/SDL_gpu.h")
set(SDL_GPU_CORE_SOURCE "${SDL3_SOURCE_DIR}/src/gpu/SDL_gpu.c")
set(SDL_GPU_VULKAN_SOURCE "${SDL3_SOURCE_DIR}/src/gpu/vulkan/SDL_gpu_vulkan.c")
if(NOT EXISTS "${SDL_GPU_HEADER}" OR
   NOT EXISTS "${SDL_GPU_CORE_SOURCE}" OR
   NOT EXISTS "${SDL_GPU_VULKAN_SOURCE}")
    message(FATAL_ERROR "The fetched source is not the pinned SDL 3 source tree")
endif()

file(READ "${SDL_GPU_HEADER}" SDL_GPU_HEADER_CONTENTS)
file(READ "${SDL_GPU_CORE_SOURCE}" SDL_GPU_CORE_CONTENTS)
file(READ "${SDL_GPU_VULKAN_SOURCE}" SDL_GPU_VULKAN_CONTENTS)
string(FIND "${SDL_GPU_HEADER_CONTENTS}" "SDL_RunGPUVulkanExternalPass" SDL_HEADER_API_MARKER)
string(FIND "${SDL_GPU_HEADER_CONTENTS}"
    "#define SDL_GPU_VULKAN_EXTERNAL_PASS_API_VERSION 2"
    SDL_HEADER_VERSION_MARKER)
string(FIND "${SDL_GPU_CORE_CONTENTS}" "SDL_RunGPUVulkanExternalPass(" SDL_CORE_PASS_MARKER)
string(FIND "${SDL_GPU_CORE_CONTENTS}" "SDL_AddGPUVulkanExtension(" SDL_CORE_EXTENSION_MARKER)
string(FIND "${SDL_GPU_VULKAN_CONTENTS}" "VULKAN_RunGPUVulkanExternalPass(" SDL_VULKAN_PASS_MARKER)
string(FIND "${SDL_GPU_VULKAN_CONTENTS}"
    "RunGPUVulkanExternalPass = VULKAN_RunGPUVulkanExternalPass"
    SDL_VULKAN_DISPATCH_MARKER)

if(NOT SDL_HEADER_API_MARKER EQUAL -1 AND
   NOT SDL_HEADER_VERSION_MARKER EQUAL -1 AND
   NOT SDL_CORE_PASS_MARKER EQUAL -1 AND
   NOT SDL_CORE_EXTENSION_MARKER EQUAL -1 AND
   NOT SDL_VULKAN_PASS_MARKER EQUAL -1 AND
   NOT SDL_VULKAN_DISPATCH_MARKER EQUAL -1)
    return()
endif()
if(NOT SDL_HEADER_API_MARKER EQUAL -1 OR
   NOT SDL_HEADER_VERSION_MARKER EQUAL -1 OR
   NOT SDL_CORE_PASS_MARKER EQUAL -1 OR
   NOT SDL_CORE_EXTENSION_MARKER EQUAL -1 OR
   NOT SDL_VULKAN_PASS_MARKER EQUAL -1 OR
   NOT SDL_VULKAN_DISPATCH_MARKER EQUAL -1)
    message(FATAL_ERROR "SDL source contains a partial or incompatible Vulkan interop patch")
endif()

execute_process(
    COMMAND "${PATCH_EXECUTABLE}" -p1 --forward --batch --fuzz=0 --input "${PATCH_FILE}"
    WORKING_DIRECTORY "${SDL3_SOURCE_DIR}"
    RESULT_VARIABLE SDL_PATCH_RESULT
    ERROR_VARIABLE SDL_PATCH_ERROR
)
if(NOT SDL_PATCH_RESULT EQUAL 0)
    message(FATAL_ERROR "Failed to apply SDL Vulkan interop patch: ${SDL_PATCH_ERROR}")
endif()

file(READ "${SDL_GPU_HEADER}" SDL_GPU_HEADER_CONTENTS)
file(READ "${SDL_GPU_CORE_SOURCE}" SDL_GPU_CORE_CONTENTS)
file(READ "${SDL_GPU_VULKAN_SOURCE}" SDL_GPU_VULKAN_CONTENTS)
string(FIND "${SDL_GPU_HEADER_CONTENTS}" "SDL_RunGPUVulkanExternalPass" SDL_HEADER_API_MARKER)
string(FIND "${SDL_GPU_HEADER_CONTENTS}"
    "#define SDL_GPU_VULKAN_EXTERNAL_PASS_API_VERSION 2"
    SDL_HEADER_VERSION_MARKER)
string(FIND "${SDL_GPU_CORE_CONTENTS}" "SDL_RunGPUVulkanExternalPass(" SDL_CORE_PASS_MARKER)
string(FIND "${SDL_GPU_CORE_CONTENTS}" "SDL_AddGPUVulkanExtension(" SDL_CORE_EXTENSION_MARKER)
string(FIND "${SDL_GPU_VULKAN_CONTENTS}" "VULKAN_RunGPUVulkanExternalPass(" SDL_VULKAN_PASS_MARKER)
string(FIND "${SDL_GPU_VULKAN_CONTENTS}"
    "RunGPUVulkanExternalPass = VULKAN_RunGPUVulkanExternalPass"
    SDL_VULKAN_DISPATCH_MARKER)
if(SDL_HEADER_API_MARKER EQUAL -1 OR
   SDL_HEADER_VERSION_MARKER EQUAL -1 OR
   SDL_CORE_PASS_MARKER EQUAL -1 OR
   SDL_CORE_EXTENSION_MARKER EQUAL -1 OR
   SDL_VULKAN_PASS_MARKER EQUAL -1 OR
   SDL_VULKAN_DISPATCH_MARKER EQUAL -1)
    message(FATAL_ERROR "SDL Vulkan interop patch completed without all expected API and backend markers")
endif()
